{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2021",
    "outDir": "dist",
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@edgebook/shared": ["../../packages/shared/src"],
      "@edgebook/shared/positions": ["../../packages/shared/src/positions/index.ts"],
      "@edgebook/shared/queues": ["../../packages/shared/src/queues/index.ts"],
      "@edgebook/db": ["../../packages/db/src"],
      "@prisma/client": ["../../node_modules/@prisma/client"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
