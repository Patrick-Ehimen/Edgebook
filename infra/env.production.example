# ─── Production env — free-tier stack ────────────────────────────────────────
#
# Service map:
#   Web (Next.js)  → Vercel        free tier
#   API (NestJS)   → Render        free tier (spins down after 15 min idle)
#   DB (Postgres)  → Supabase      free tier (500 MB, plain Postgres — no TimescaleDB needed)
#   Redis          → Upstash       free tier (10k req/day)
#   Worker         → merged into API process on Render (see apps/worker/src/main.ts)
#
# Set these in each platform's dashboard — never commit real values.

# ── Shared (API + Worker) ─────────────────────────────────────────────────────

# Supabase → Project Settings → Database → Connection string → Transaction pooler
# (port 6543, ?pgbouncer=true). This is what Render/Fly actually run against —
# set only DATABASE_URL there.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true

# Supabase → Project Settings → Database → Connection string → Session pooler
# (same [HOST], port 5432, no pgbouncer flag). NOT the "Direct connection" string
# Supabase shows first — that one is IPv6-only and won't connect from most
# networks unless you're on the paid IPv4 add-on. The session pooler is the
# IPv4-compatible equivalent and still supports prepared statements.
# NOT set on Render/Fly — this is only for running `pnpm db:migrate:deploy` /
# `pnpm db:generate` / `pnpm db:seed` locally against the Supabase project
# (see packages/db/prisma.config.ts). The transaction pooler above doesn't
# support the prepared statements Prisma's migration engine needs.
# DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Upstash → Redis → REST details → copy the redis://... URL
REDIS_URL=rediss://:[TOKEN]@[HOST]:6379

# Generate: openssl rand -base64 48
JWT_SECRET=

# Generate: openssl rand -hex 32
# Same value must be set on both API and Worker — used to decrypt stored API key secrets.
ENCRYPTION_KEY=

NODE_ENV=production
PORT=3001

# Your Vercel web deployment URL
APP_URL=https://your-app.vercel.app

# ── API only ──────────────────────────────────────────────────────────────────

TOTP_ISSUER=Edgebook

# OAuth — create credentials at console.cloud.google.com
# Callback must match exactly what's registered there.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://your-api.onrender.com/api/auth/google/callback

# ── Web (Vercel env vars) ─────────────────────────────────────────────────────

# Your Render API deployment URL
NEXT_PUBLIC_API_URL=https://your-api.onrender.com/api
