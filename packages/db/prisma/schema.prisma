generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum OAuthProvider {
  google
  github
  x
}

enum AuditKind {
  SIGNUP
  SIGNIN
  SIGNIN_FAILED
  SIGNOUT
  EMAIL_VERIFIED
  TWO_FACTOR_ENROLLED
  TWO_FACTOR_DISABLED
  PASSWORD_CHANGED
  OAUTH_LINKED
  RECOVERY_CODE_USED
  API_KEY_ADDED
  API_KEY_REMOVED
  EXPORT_REQUESTED
  ONBOARDING_COMPLETED
}

enum Venue {
  binance
  bybit
}

enum AccountType {
  futures
  spot
  margin
}

enum AccountCategory {
  live
  demo
  prop
}

enum FillSide {
  buy
  sell
}

enum PositionSide {
  long
  short
}

enum PositionStatus {
  open
  closed
}

enum PositionFillRole {
  entry
  scale_in
  exit
  scale_out
}

enum AlertAction {
  notify
  pause
}

enum GoalPeriod {
  daily
  weekly
  monthly
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  handle          String    @unique
  email           String    @unique
  emailVerifiedAt DateTime? @db.Timestamptz
  passwordHash    String?
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz
  isOnboarded     Boolean   @default(false)

  sessions       Session[]
  totpSecret     TotpSecret?
  recoveryCodes  RecoveryCode[]
  passwordResets PasswordReset[]
  oauthAccounts  OAuthAccount[]
  auditEvents    AuditEvent[]
  accounts       Account[]
  playbooks      Playbook[]
  journalEntries JournalEntry[]
  goals          Goal[]
  alertRules     AlertRule[]
  aiReports      AiReport[]
  libraryNotes   LibraryNote[]
  propAccounts   PropAccount[]
  watchlistItems WatchlistItem[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  jwtId     String    @unique
  ip        String?
  userAgent String?
  expiresAt DateTime  @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TotpSecret {
  id         String   @id @default(cuid())
  userId     String   @unique
  secretEnc  String
  enrolledAt DateTime @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime @db.Timestamptz
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([email])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime @db.Timestamptz
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Append-only — never DELETE or UPDATE rows in this table.
model AuditEvent {
  id          String    @id @default(cuid())
  userId      String?
  kind        AuditKind
  ip          String?
  userAgent   String?
  payloadJson Json      @default("{}")
  createdAt   DateTime  @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

// ─── Exchange accounts ────────────────────────────────────────────────────────

model Account {
  id           String          @id @default(cuid())
  userId       String
  venue        Venue
  label        String
  accountType  AccountType
  category     AccountCategory @default(live)
  baseCurrency String
  createdAt    DateTime        @default(now()) @db.Timestamptz

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys   ApiKey[]
  fills     Fill[]
  positions Position[]

  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  accountId  String
  keyIdHash  String
  keyEnc     String
  secretEnc  String
  scope      String[]
  lastUsedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// ─── Fills (immutable, append-only) ──────────────────────────────────────────

/// Append-only — never UPDATE fills rows. Re-derive positions from fills only.
model Fill {
  id              BigInt   @id @default(autoincrement())
  accountId       String
  venue           Venue
  symbol          String
  side            FillSide
  qty             Decimal  @db.Decimal(30, 10)
  price           Decimal  @db.Decimal(30, 10)
  fee             Decimal  @db.Decimal(30, 10)
  feeCcy          String
  fundingFee      Decimal? @db.Decimal(30, 10)
  exchangeTradeId String
  executedAt      DateTime @db.Timestamptz
  createdAt       DateTime @default(now()) @db.Timestamptz
  thesis          String?
  invalidation    String?
  notes           String?
  sl              String?
  tp              String?
  conviction      Int?
  moods           String[]

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  positionFills PositionFill[]

  @@unique([accountId, exchangeTradeId])
  @@index([accountId, executedAt(sort: Desc)])
}

// ─── Positions (derived from fills via FIFO algorithm) ───────────────────────

model Position {
  id         String         @id @default(cuid())
  accountId  String
  symbol     String
  side       PositionSide
  openedAt   DateTime       @db.Timestamptz
  closedAt   DateTime?      @db.Timestamptz
  qtyMax     Decimal        @db.Decimal(30, 10)
  avgEntry   Decimal        @db.Decimal(30, 10)
  avgExit    Decimal?       @db.Decimal(30, 10)
  grossPnl   Decimal        @db.Decimal(30, 10)
  fees       Decimal        @db.Decimal(30, 10)
  funding    Decimal        @db.Decimal(30, 10)
  netPnl     Decimal        @db.Decimal(30, 10)
  rPlanned      Decimal?       @db.Decimal(10, 4)
  rRealized     Decimal?       @db.Decimal(10, 4)
  mfe           Decimal?       @db.Decimal(10, 4)
  mae           Decimal?       @db.Decimal(10, 4)
  wentRight     String?
  wentWrong     String?
  lesson        String?
  planAdherence Decimal?       @db.Decimal(5, 2)
  processScore  Decimal?       @db.Decimal(4, 1)
  outcomeScore  Decimal?       @db.Decimal(4, 1)
  playbookId      String?
  conviction      Int?
  status          PositionStatus
  sourceHash      String
  checklistState  Json?

  account            Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  playbook           Playbook?           @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  positionFills      PositionFill[]
  tags               PositionTag[]
  notes              PositionNote?
  checklistResponses ChecklistResponse[]

  @@index([accountId, closedAt(sort: Desc)])
  @@index([accountId, playbookId, closedAt])
}

model PositionFill {
  positionId String
  fillId     BigInt
  role       PositionFillRole

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  fill     Fill     @relation(fields: [fillId], references: [id], onDelete: Restrict)

  @@id([positionId, fillId])
}

model PositionTag {
  positionId String
  tag        String

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([positionId, tag])
  @@index([tag])
}

model PositionNote {
  id         String   @id @default(cuid())
  positionId String   @unique
  bodyMd     String
  images     String[]
  updatedAt  DateTime @updatedAt @db.Timestamptz

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

// ─── Playbooks ────────────────────────────────────────────────────────────────

enum PlaybookStatus {
  experimental
  active
  paused
}

model Playbook {
  id             String         @id @default(cuid())
  userId         String
  name           String
  thesis         String
  status         PlaybookStatus @default(experimental)
  criteriaJson   Json           @default("{}")
  sampleChartUrl String?
  images         String[]
  createdAt      DateTime       @default(now()) @db.Timestamptz
  updatedAt      DateTime       @updatedAt @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklists   Checklist[]
  positions    Position[]
  libraryNotes LibraryNote[]

  @@index([userId])
}

model Checklist {
  id         String @id @default(cuid())
  playbookId String
  itemsJson  Json   @default("[]")

  playbook           Playbook            @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  checklistResponses ChecklistResponse[]
}

model ChecklistResponse {
  id          String @id @default(cuid())
  positionId  String
  checklistId String
  itemId      String
  value       Json

  position  Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@unique([positionId, checklistId, itemId])
}

// ─── Journal ──────────────────────────────────────────────────────────────────

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @db.Date

  intentMd      String?
  bias          String?
  conviction    Int?
  riskCap       Decimal? @db.Decimal(5, 2)
  maxTrades     Int?
  maxRiskNote   String?
  keyLevelsJson Json?
  noTradeJson   Json?
  watchlistJson Json?
  focus         Int?
  moodTagsJson  Json?
  lockedAt      DateTime? @db.Timestamptz

  sessionNotesMd String?

  sleepHours Decimal? @db.Decimal(4, 2)
  energy     Int?
  mood       Int?

  eodMd         String?
  planAdherence Int?
  processScore  Int?
  outcomeScore  Int?
  wentRightMd   String?
  wentWrongMd   String?
  lesson        String?
  tomorrowMd    String?
  tagsJson      Json?
  energyEod     Int?
  tiltRisk      Int?
  confidenceEod Int?
  finalizedAt   DateTime? @db.Timestamptz
  pinned        Boolean   @default(false)

  images    String[]
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// ─── Goals ────────────────────────────────────────────────────────────────────

model Goal {
  id      String     @id @default(cuid())
  userId  String
  period  GoalPeriod
  type    String
  target  Decimal    @db.Decimal(10, 4)
  current Decimal    @default(0) @db.Decimal(10, 4)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Alerts ───────────────────────────────────────────────────────────────────

model AlertRule {
  id         String      @id @default(cuid())
  userId     String
  kind       String
  paramsJson Json        @default("{}")
  action     AlertAction
  enabled    Boolean     @default(true)
  createdAt  DateTime    @default(now()) @db.Timestamptz

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertEvents AlertEvent[]

  @@index([userId])
}

model AlertEvent {
  id          String    @id @default(cuid())
  ruleId      String
  firedAt     DateTime  @db.Timestamptz
  payloadJson Json      @default("{}")
  ackByUserAt DateTime? @db.Timestamptz

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([firedAt])
}

// ─── AI Reports ───────────────────────────────────────────────────────────────

model AiReport {
  id         String   @id @default(cuid())
  userId     String
  period     String
  model      String
  promptHash String
  bodyMd     String
  createdAt  DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, promptHash])
  @@index([userId])
}

// ─── Library / Notes ──────────────────────────────────────────────────────────

model LibraryNote {
  id         String   @id @default(cuid())
  userId     String
  folderId   String
  name       String
  iconId     String   @default("file")
  bodyMd     String   @default("")
  pinned     Boolean  @default(false)
  tags       String[] @default([])
  playbookId String?
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  playbook Playbook? @relation(fields: [playbookId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, folderId])
  @@index([userId, pinned])
  @@index([playbookId])
}

// ─── Prop trading ─────────────────────────────────────────────────────────────

enum DrawdownKind {
  STATIC
  EOD_TRAILING
  TICK_TRAILING
}

enum PropAccountStatus {
  EVAL
  FUNDED
  PASSED
  SUSPENDED
  CLOSED
}

enum PropEventKind {
  DAILY_LOSS_WARNING
  DAILY_LOSS_BREACH
  DRAWDOWN_WARNING
  DRAWDOWN_BREACH
  CONSISTENCY_WARNING
  CONSISTENCY_BREACH
  SL_MISSING_WARNING
  EXPOSURE_WARNING
  PROFIT_TARGET_HIT
  MIN_DAYS_MET
  DAILY_RESET
  ACCOUNT_LOCKED
}

enum PropEventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum PropPayoutStatus {
  PENDING
  PAID
  REJECTED
}

/// Reference data — one row per supported firm. Managed by Edgebook team.
model PropFirm {
  id           String   @id @default(cuid())
  slug         String   @unique // "hyrotrader" | "sizeprop" | "velotrade"
  name         String
  website      String
  logoInitial  String   // single letter for the avatar
  logoColor    String   // hex or CSS gradient string for avatar bg
  exchanges    String[] // real-money execution venues e.g. ["bybit","binance","okx"]
  flags        String[] // e.g. ["US_BANNED", "FINMA_WARNING"]
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  rulePacks PropFirmRulePack[]
  accounts  PropAccount[]
}

/// Versioned rule configuration per firm × account-size × phase.
/// Bump version when a firm changes its terms; old packs stay linked to existing accounts.
model PropFirmRulePack {
  id          String   @id @default(cuid())
  firmId      String
  version     String   // "2026.06"
  accountSize Decimal  @db.Decimal(20, 2) // USDT notional e.g. 5000.00
  phase       Int      // 1 or 2
  isActive    Boolean  @default(true)

  // Profit
  profitTargetPct Decimal @db.Decimal(6, 4) // 0.1000 = 10%

  // Drawdown
  drawdownKind      DrawdownKind
  maxDailyLossPct   Decimal?     @db.Decimal(6, 4)
  maxOverallLossPct Decimal      @db.Decimal(6, 4)

  // Consistency — eval phase only
  consistencyMaxDayPct Decimal? @db.Decimal(6, 4) // 0.40 = no single day > 40% of total eval profit

  // Trading constraints
  minTradingDays       Int?
  timeLimitDays        Int?
  maxRiskPerTradePct   Decimal? @db.Decimal(6, 4) // HyroTrader funded: 0.03
  maxTotalExposurePct  Decimal? @db.Decimal(6, 4) // HyroTrader funded: 0.25
  slRequiredWithinSecs Int?                        // HyroTrader: 300 (5 min)

  // Position holding
  weekendHoldAllowed   Boolean @default(true)
  overnightHoldAllowed Boolean @default(true)

  // Payout
  profitSplitPct Decimal @db.Decimal(6, 4) // 0.70 = 70%

  // Meta
  verifiedAt DateTime @db.Timestamptz
  notes      String?

  firm     PropFirm      @relation(fields: [firmId], references: [id])
  accounts PropAccount[]

  @@unique([firmId, accountSize, phase, version])
  @@index([firmId, isActive])
}

model PropAccount {
  id          String            @id @default(cuid())
  userId      String
  firmId      String
  rulePackId  String
  label       String
  externalId  String?           // firm-assigned account ID
  accountSize Decimal           @db.Decimal(20, 2)
  phase       Int
  status      PropAccountStatus @default(EVAL)
  startedAt   DateTime          @db.Timestamptz
  endedAt     DateTime?         @db.Timestamptz

  // Recomputed compliance state — updated by prop.compliance.recompute worker job
  peakBalance       Decimal? @db.Decimal(30, 10) // high-water mark for trailing DD
  todayStartBalance Decimal? @db.Decimal(30, 10) // balance at start of today (UTC) for daily loss
  currentBalance    Decimal? @db.Decimal(30, 10)
  tradingDaysCount  Int      @default(0)

  // Optional link to an exchange sub-account for auto-sync
  exchangeAccountId String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  firm     PropFirm         @relation(fields: [firmId], references: [id])
  rulePack PropFirmRulePack @relation(fields: [rulePackId], references: [id])
  events   PropComplianceEvent[]
  payouts  PropPayout[]

  @@index([userId])
  @@index([userId, status])
}

/// Append-only compliance event log — never DELETE or UPDATE rows in this table.
model PropComplianceEvent {
  id            String            @id @default(cuid())
  propAccountId String
  kind          PropEventKind
  severity      PropEventSeverity
  message       String
  metadata      Json?
  occurredAt    DateTime          @default(now()) @db.Timestamptz

  account PropAccount @relation(fields: [propAccountId], references: [id], onDelete: Cascade)

  @@index([propAccountId, occurredAt(sort: Desc)])
  @@index([propAccountId, kind])
}

model PropPayout {
  id            String           @id @default(cuid())
  propAccountId String
  userId        String
  grossAmount   Decimal          @db.Decimal(20, 4)
  splitPct      Decimal          @db.Decimal(6, 4)
  netAmount     Decimal          @db.Decimal(20, 4)
  status        PropPayoutStatus @default(PENDING)
  requestedAt   DateTime         @db.Timestamptz
  paidAt        DateTime?        @db.Timestamptz
  notes         String?
  createdAt     DateTime         @default(now()) @db.Timestamptz

  account PropAccount @relation(fields: [propAccountId], references: [id], onDelete: Cascade)

  @@index([propAccountId])
  @@index([userId])
}

// ─── Watchlist ────────────────────────────────────────────────────────────────

model WatchlistItem {
  id               String   @id @default(cuid())
  userId           String
  symbol           String
  horizon          String
  bias             String
  notes            String?
  conviction       Int      @default(3)
  convictionReason String?
  tags             String[]
  playbookNames    String[]
  keyLevelsJson    Json     @default("[]")
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, horizon])
}
